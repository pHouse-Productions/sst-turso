{
  "name": "sst-turso",
  "version": "0.4.0",
  "description": "SST component for Turso (libSQL) databases, built on the Turso Platform API.",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./runtime": {
      "types": "./runtime.d.ts",
      "default": "./runtime.js"
    },
    "./kysely": {
      "types": "./kysely.d.ts",
      "default": "./kysely.js"
    }
  },
  "types": "./index.ts",
  "files": [
    "index.ts",
    "runtime.js",
    "runtime.d.ts",
    "kysely.js",
    "kysely.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@libsql/client": ">=0.15",
    "kysely": ">=0.28",
    "sst": ">=3"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "kysely": "^0.29.9",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pHouse-Productions/sst-turso.git"
  }
}
